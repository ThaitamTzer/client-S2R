# API Configuration
NEXT_PUBLIC_API_URL=https://api.share2receive.com
NEXT_PUBLIC_API_VERSION=v1

# Environment
NODE_ENV=development
NEXT_PUBLIC_ENV=development

# Application
NEXT_PUBLIC_APP_NAME=Share2Receive
NEXT_PUBLIC_APP_URL=https://share2receive.com

# External Services
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
NEXT_PUBLIC_SOCKET_URL=wss://socket.share2receive.com

# Performance Monitoring
NEXT_PUBLIC_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_BUNDLE_ANALYZER=false

# Security
NEXT_PUBLIC_CSP_NONCE=
NEXT_PUBLIC_SECURITY_HEADERS=true